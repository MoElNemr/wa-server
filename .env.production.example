NODE_ENV=production
PORT=3000

# Laravel backend URL (used as default webhook base if business doesn't pass webhook_url)
LARAVEL_APP_URL=https://vertex.78sworks.io

# Shared secret between Laravel and this Node server (must match WHATSAPP_SERVICE_SECRET in Laravel .env)
SHARED_SECRET=your_shared_secret_here

# CORS - allow requests from Laravel production domain
CORS_ORIGIN=https://vertex.78sworks.io
